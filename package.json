{
  "name": "video-gen",
  "version": "1.0.0",
  "private": true,
  "description": "Narration-synchronized motion design with HyperFrames",
  "scripts": {
    "ui": "node ui/server.mjs",
    "test:ui": "node --test ui/tests/*.test.mjs",
    "test:ui:browser": "node ui/tests/browser.mjs",
    "test:ui:live": "node ui/tests/live-smoke.mjs",
    "video": "node scripts/video.mjs",
    "dev": "node scripts/video.mjs preview",
